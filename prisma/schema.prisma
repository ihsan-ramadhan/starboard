generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  code  String  @id
  name  String?
  color String?
  icon  String?
  users User[]

  @@map("departments")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())

  department Department        @relation(fields: [role], references: [code])
  sessions   Session[]
  widgets    DashboardWidget[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model DatasetRegistry {
  id          String   @id @default(cuid())
  dept        String
  key         String
  tableName   String
  displayName String
  createdBy   String?
  createdAt   DateTime @default(now())

  columns DatasetColumn[]
  widgets DashboardWidget[]

  @@unique([dept, key])
  @@map("dataset_registry")
}

model DatasetColumn {
  id          String  @id @default(cuid())
  datasetId   String
  name        String
  label       String?
  type        String
  isDimension Boolean @default(false)

  dataset DatasetRegistry @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, name])
  @@map("dataset_columns")
}

model DashboardWidget {
  id           String   @id @default(cuid())
  userId       String?
  datasetId    String
  widgetKey    String
  chartType    String
  positionX    Int
  positionY    Int
  width        Int
  height       Int
  filterConfig Json?

  dataset DatasetRegistry @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, datasetId, widgetKey])
  @@map("dashboard_widgets")
}
